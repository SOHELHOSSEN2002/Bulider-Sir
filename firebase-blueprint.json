{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Portfolio owner biography and contact details",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "taglines": { "type": "string", "maxLength": 300 },
        "aboutBio": { "type": "string", "maxLength": 3000 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "github": { "type": "string", "maxLength": 200 },
        "linkedin": { "type": "string", "maxLength": 200 },
        "resumeUrl": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "yearsExperience": { "type": "number" },
        "projectsCompleted": { "type": "number" },
        "clientSatisfaction": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["fullName", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Showcase portfolio projects",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 500 },
        "tags": { "type": "string", "maxLength": 250 },
        "liveUrl": { "type": "string", "maxLength": 300 },
        "githubUrl": { "type": "string", "maxLength": 300 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "category", "description"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical and design proficiencies",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 60 },
        "proficiency": { "type": "number" },
        "iconName": { "type": "string", "maxLength": 60 },
        "order": { "type": "number" }
      },
      "required": ["name", "category", "proficiency"]
    },
    "Service": {
      "title": "Service",
      "description": "Offered development and consulting services",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "iconName": { "type": "string", "maxLength": 60 },
        "features": { "type": "string", "maxLength": 600 },
        "priceRange": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["title", "description"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Portfolio articles and dev journals",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 10000 },
        "readTime": { "type": "string", "maxLength": 40 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "likes": { "type": "number" }
      },
      "required": ["title", "category", "content"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound messages sent by visitors through the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "read": { "type": "boolean" },
        "replied": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "email", "message"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website settings, 380x100 logo image, slides, about, categories, services headers",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "heroSlides": { "type": "array" },
        "aboutSettings": { "type": "object" },
        "aboutTimeline": { "type": "array" },
        "skillsCategories": { "type": "array" },
        "servicesHeader": { "type": "object" }
      }
    },
    "AdminCreds": {
      "title": "AdminCreds",
      "description": "Admin login credentials and recovery information",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "recoveryEmail": { "type": "string" },
        "recoveryCode": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global website settings and content"
    },
    "/admins/{adminId}": {
      "schema": "AdminCreds",
      "description": "Admin authentication credentials"
    },
    "/profile/{profileId}": {
      "schema": "Profile",
      "description": "Site profile, bio and configuration"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects showcase"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Skill entries and proficiency ratings"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Services offered to clients"
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Articles, technical blogs and publications"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Visitor contact messages received"
    }
  }
}
